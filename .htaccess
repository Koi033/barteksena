# .htaccess - RAÍZ del proyecto Bartek
Options -Indexes
RewriteEngine On

# Bloquear acceso directo a carpetas internas del MVC
# NOTA: public/ NO está en esta lista para que sirva los assets
RewriteRule ^(app|config|setup|sql)(/.*)?$ - [F,L]

# Bloquear archivos sensibles en la raíz
<FilesMatch "\.(sql|log|env|md|json|lock|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Si el archivo o directorio existe (assets en public/), servir directo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demás al Front Controller
RewriteRule ^(.*)$ index.php [QSA,L]

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
